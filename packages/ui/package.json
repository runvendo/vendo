{
  "name": "@vendoai/ui",
  "version": "0.37.0",
  "description": "Headless hooks + optional chrome for Vendo: the client, every surface, and the vendo-genui/v2 tree renderer.",
  "keywords": [
    "ai",
    "agent",
    "genui",
    "react",
    "vendo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runvendo/vendo.git",
    "directory": "packages/ui"
  },
  "homepage": "https://vendo.run",
  "bugs": "https://github.com/runvendo/vendo/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "default": "./dist/chrome/index.js"
    },
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "default": "./dist/tree/index.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm run check:icons",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/build-eject-templates.mjs",
    "pretest": "pnpm run check:icons",
    "test": "vitest run",
    "pretypecheck": "pnpm run check:icons",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:browser": "playwright test",
    "test:ui": "playwright test e2e/smoke.spec.ts",
    "test:mcp-shim": "playwright test --config e2e/mcp-shim.config.ts",
    "build:mcp-shim": "node scripts/build-mcp-app-shim.mjs",
    "build:onest-font": "node scripts/build-onest-font.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "check:icons": "node scripts/build-icons.mjs --check",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.30",
    "@base-ui/react": "1.7.0",
    "@tanstack/react-table": "^8.20.0",
    "@vendoai/apps": "workspace:*",
    "@vendoai/core": "workspace:*",
    "aria-snapshot": "0.2.0",
    "clsx": "2.1.1",
    "react-markdown": "^9.0.1",
    "recharts": "^3.2.0",
    "remark-gfm": "^4.0.0",
    "sucrase": "^3.35.0",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "ai": ">=6.0.0 <8",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": ">=3.25.0 <5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ai": "6.0.28",
    "jsdom": "^25.0.0",
    "lucide": "1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}

{
  "name": "@vendoai/cli",
  "version": "0.59.0",
  "description": "The Vendo CLI: init, doctor, sync, config, knowledge, mcp and the Cloud login.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "genui",
    "vendo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runvendo/vendo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://vendo.run",
  "bugs": "https://github.com/runvendo/vendo/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vendo": "bin/vendo.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "default": "./dist/extract/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vendoai/core": "workspace:*",
    "@vendoai/vendo": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "zod": ">=3.25.0 <5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}

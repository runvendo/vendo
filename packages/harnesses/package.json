{
  "name": "@vendoai/harnesses",
  "version": "0.52.1",
  "description": "The harness runtime: runs any Harness safely, and vendo() — the default in-process thinker.",
  "keywords": [
    "ai",
    "agent",
    "harness",
    "vendo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runvendo/vendo.git",
    "directory": "packages/harnesses"
  },
  "homepage": "https://vendo.run",
  "bugs": "https://github.com/runvendo/vendo/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vendo": {
      "types": "./dist/vendo/index.d.ts",
      "default": "./dist/vendo/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "default": "./dist/claude-code/index.js"
    },
    "./claude-code/box": {
      "types": "./dist/claude-code/box.d.ts",
      "default": "./dist/claude-code/box.js"
    },
    "./inference": {
      "types": "./dist/inference/model.d.ts",
      "default": "./dist/inference/model.js"
    },
    "./inference/credential": {
      "types": "./dist/inference/resolve.d.ts",
      "default": "./dist/inference/resolve.js"
    },
    "./claude-turn": {
      "types": "./dist/claude-code/claude-turn.d.ts",
      "default": "./dist/claude-code/claude-turn.js"
    },
    "./box-door": {
      "default": "./box/turn-routes.mjs"
    }
  },
  "files": [
    "dist",
    "box",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.12",
    "@e965/xlsx": "0.20.3",
    "@vendoai/apps": "workspace:*",
    "@vendoai/core": "workspace:*",
    "@vendoai/guard": "workspace:*",
    "fflate": "^0.8.3",
    "just-bash": "^3.4.2",
    "unpdf": "^1.8.1",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "ai": ">=6.0.0 <8",
    "zod": ">=3.25.0 <5",
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0 <1"
  },
  "devDependencies": {
    "@ai-sdk/openai": "3.0.9",
    "@ai-sdk/openai-compatible": "2.0.9",
    "@types/node": "^22.0.0",
    "ai": "6.0.28",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}

{
  "name": "@vendoai/apps",
  "version": "0.36.2",
  "description": "The Vendo app artifact, build engine, sandbox seam, and runtime.",
  "keywords": [
    "ai",
    "agent",
    "apps",
    "vendo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runvendo/vendo.git",
    "directory": "packages/apps"
  },
  "homepage": "https://vendo.run",
  "bugs": "https://github.com/runvendo/vendo/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./e2b": {
      "types": "./dist/server/escalation/e2b/index.d.ts",
      "default": "./dist/server/escalation/e2b/index.js"
    },
    "./edge": {
      "types": "./dist/server/edge/index.d.ts",
      "default": "./dist/server/edge/index.js"
    },
    "./testing": {
      "types": "./dist/server/testing/index.d.ts",
      "default": "./dist/server/testing/index.js"
    }
  },
  "files": [
    "dist",
    "quickjs.wasm",
    "README.md",
    "box"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync(require.resolve('@jitl/quickjs-wasmfile-release-sync/wasm'), 'quickjs.wasm')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@vendoai/core": "workspace:*",
    "acorn": "^8.15.0",
    "croner": "^9.0.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.0",
    "preact": "10.24.3",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0 <1",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "ai": ">=6.0.0 <8",
    "e2b": "^2.32.0",
    "sucrase": "^3.35.0",
    "typescript": ">=5.6.0 <7",
    "vitest": "^2.0.0 || ^3.0.0",
    "zod": ">=3.25.0 <5"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "sucrase": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "3.0.12",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@types/node": "^22.0.0",
    "ai": "6.0.28",
    "e2b": "^2.32.0",
    "just-bash": "^3.1.0",
    "sucrase": "^3.35.0",
    "typescript": "^5.6.0",
    "typescript-6": "npm:typescript@6.0.3",
    "vitest": "^3.2.6"
  },
  "imports": {
    "#engine/wasm": {
      "node": "./dist/contract/genui/wasm-node.js",
      "default": "./dist/contract/genui/wasm-browser.js"
    }
  }
}

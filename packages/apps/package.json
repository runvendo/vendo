{
  "name": "@vendoai/apps",
  "version": "0.9.0",
  "description": "The Vendo app artifact, build engine, sandbox seam, and runtime.",
  "keywords": [
    "ai",
    "agent",
    "apps",
    "vendo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runvendo/vendo.git",
    "directory": "packages/apps"
  },
  "homepage": "https://vendo.run",
  "bugs": "https://github.com/runvendo/vendo/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./e2b": {
      "types": "./dist/e2b/index.d.ts",
      "default": "./dist/e2b/index.js"
    },
    "./sandbox-ladder": {
      "types": "./dist/sandbox-ladder.d.ts",
      "default": "./dist/sandbox-ladder.js"
    },
    "./adapter-conformance": {
      "types": "./dist/adapter-conformance.d.ts",
      "default": "./dist/adapter-conformance.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "box"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vendoai/core": "workspace:*",
    "croner": "^9.0.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0 <1",
    "ai": ">=6.0.0 <7",
    "e2b": "^2.32.0",
    "vitest": "^2.0.0 || ^3.0.0",
    "zod": ">=3.25.0 <5"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "3.0.12",
    "@types/node": "^22.0.0",
    "ai": "6.0.28",
    "e2b": "^2.32.0",
    "just-bash": "^3.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}

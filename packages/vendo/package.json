{
  "name": "@vendoai/vendo",
  "version": "0.61.2",
  "description": "The Vendo umbrella: the v0 contracts, default composition, public wire routes, the React provider and headless UI, and the `vendo` CLI.",
  "keywords": [
    "ai",
    "agent",
    "genui",
    "react",
    "vendo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runvendo/vendo.git",
    "directory": "packages/vendo"
  },
  "homepage": "https://vendo.run",
  "bugs": "https://github.com/runvendo/vendo/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,

    "dist",
    "quickjs.wasm",
    "bin",
    "box",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\" && node -e \"require('node:fs').copyFileSync(require.resolve('@jitl/quickjs-wasmfile-release-sync/wasm'), 'quickjs.wasm')\"",
    "test": "vitest run",
    "conformance": "vitest run tests/conformance.test.ts tests/store/conformance.test.ts tests/store/security/audit-append-only.conformance.test.ts tests/store/security/secrets-aad.conformance.test.ts tests/store/flip-guards.conformance.test.ts tests/store/erase.conformance.test.ts tests/store/workspace.erase.test.ts tests/store/postgres-gate.test.ts tests/core/contract-coverage.e2e.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.docs-check.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "prebuild": "pnpm run check:icons",
    "pretest": "pnpm run check:icons",
    "pretypecheck": "pnpm run check:icons",
    "test:browser": "playwright test",
    "test:ui": "playwright test e2e/smoke.spec.ts",
    "test:mcp-shim": "playwright test --config e2e/mcp-shim.config.ts",
    "build:mcp-shim": "node scripts/build-mcp-app-shim.mjs",
    "build:onest-font": "node scripts/build-onest-font.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "check:icons": "node scripts/build-icons.mjs --check"
  },

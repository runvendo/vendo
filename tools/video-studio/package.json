{
  "name": "video-studio",
  "version": "0.0.0",
  "private": true,
  "description": "The Vendo video harness. Remotion episodes whose scenes render the real @vendoai/* product components — see README.md to add an episode.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prerender": "pnpm --filter @vendoai/ui build:jail",
    "render": "remotion render OneClickKnowledge out/one-click-knowledge.mp4",
    "prepreview": "pnpm --filter @vendoai/ui build:jail",
    "preview": "remotion studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@vendoai/core": "workspace:*",
    "@vendoai/ui": "workspace:*",
    "ai": "6.0.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.499",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

# Copy to .env.local and fill in. Nothing here is required to run the shop —
# with all of it unset, Crate boots as the seeded owner and every screen works.
# Each line switches on one more of the things `vendo doctor` checks.

# This deployment's FULL public URL — path prefix included. Nothing strips its
# path: every URL Vendo builds (host tool calls, login redirects, box callbacks)
# hangs off it. Dev trusts the request's own origin automatically; production
# fails loud without this set (a credential-forwarding call errors instead of
# silently running unauthenticated).
VENDO_BASE_URL=http://localhost:3000

# Optional — the host API on another origin (default: the public URL above).
# VENDO_HOST_API_URL=
# Optional — the login page (default: {public URL}/login). May be absolute,
# on another domain.
# VENDO_LOGIN_URL=

# --- Model ---------------------------------------------------------------
# REQUIRED in production, and required for `vendo doctor`'s live turn. In dev,
# `vendo login` mints a free starter key into .env.local instead.
# ANTHROPIC_API_KEY=
# VENDO_API_KEY=

# --- Clerk ---------------------------------------------------------------
# Both or neither. With them unset Crate skips Clerk entirely and acts as the
# seeded owner (yousef@crate.com); with them set, sign-in is enforced and the
# signed-in email must match a name on Crate's staff roster. Get them from
# dashboard.clerk.com — the free tier is enough.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Optional — Clerk's PEM public key, for networkless session verification.
# CLERK_JWT_KEY=

# Signs the host-owned away token that stands in for a Clerk session on an
# unattended run: Clerk holds its own signing keys, so Vendo cannot mint a Clerk
# session and mints this instead. Any random 32+ byte string; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# VENDO_AWAY_TOKEN_SECRET=

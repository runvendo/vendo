    {
      "name": "host_getCashflowInsights",
      "description": "Cash inflow/outflow summary.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "description": "The cashflow periods live under `data` — the array itself is `data`, never the response body.",
        "properties": {
          "data": {
            "type": "array",
            "description": "One entry per period, oldest first.",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "in": {
                  "type": "integer",
                  "description": "Money in for the period, in integer cents (e.g. 1284000 = $12,840.00): divide by 100 exactly once before displaying, including any totals you compute."
                },
                "out": {
                  "type": "integer",
                  "description": "Money out for the period, in integer cents: divide by 100 exactly once before displaying."
                }
              },
              "required": [
                "label",
                "in",
                "out"
              ]
            }
          }
        },
        "required": [
          "data"
        ]
      },

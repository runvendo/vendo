# Required: chat and generated UI model
# A CREDENTIAL, not a selection: it funds the model the composition selects
# (src/vendo/server.ts) and no longer picks one by itself. Set VENDO_API_KEY
# below instead to run the same seats on the Vendo Cloud gateway.
ANTHROPIC_API_KEY=

# Vendo credential forwarding + MCP door
# This deployment's FULL public URL — path prefix included. Nothing strips its
# path: every URL Vendo builds (host tool calls, login redirects, the door's
# OAuth discovery/audience URLs) hangs off it. Maple is served under /maple
# (next.config.ts `basePath`), so the prefix belongs here too.
VENDO_BASE_URL=http://localhost:3000/maple
# Optional — the host API on another origin (default: the public URL above).
# VENDO_HOST_API_URL=
# Optional — the login page (default: {public URL}/login). May be absolute,
# on another domain.
# VENDO_LOGIN_URL=

# Auth.js (real Maple login)
# Required in production; outside production a fixed local development secret
# is used so the demo boots with zero configuration. Away execution mints real
# session tokens with this same secret. Generate one with `pnpm exec auth secret`.
# AUTH_SECRET=
# Seeded demo users: yousef@maple.com (override with MAPLE_DEMO_EMAIL) and
# mia@maple.com. Both share MAPLE_DEMO_PASSWORD (default outside production:
# maple-demo). Required in production.
# MAPLE_DEMO_EMAIL=yousef@maple.com
# MAPLE_DEMO_PASSWORD=

# Optional: Vendo Cloud
# One key fills every adapter slot Maple leaves unset: the hosted store, the
# managed sandbox, the Cloud tools connector, and the knowledge engine — with
# a key set, `vendo_knowledge_search` answers from the corpus connected in the
# console instead of Maple's built-in demo corpus. Nothing else to wire.
# VENDO_API_KEY=
# Points the Cloud adapters at another console (a local one at :3001, say).
# This is the VENDO CONSOLE's origin — VENDO_BASE_URL above is Maple's own.
# VENDO_CONSOLE_URL=
# Pins a local PGlite store even with a key set, so a laptop never shares the
# deployed demo's tenant.
# MAPLE_STORE=local

# Optional: Composio integrations
# Enables the configured Gmail and Slack connector tools.
# COMPOSIO_API_KEY=

# Optional: voice
# Enables the microphone flow by minting OpenAI Realtime client secrets.
# OPENAI_API_KEY=
# Overrides the OpenAI Realtime model used by /api/voice.
# OPENAI_REALTIME_MODEL=
# Overrides the OpenAI Realtime output voice.
# OPENAI_REALTIME_VOICE=

# Optional: model and deployment controls
# Anthropic model id for the chat agent.
# VENDO_DEMO_MODEL=
# Set to 1 only when intentionally exposing a deployed demo to non-local requests.
# VENDO_DEMO_PUBLIC=

# Durable Vendo/OAuth store. Railway should reference Postgres.DATABASE_URL.
# DATABASE_URL=

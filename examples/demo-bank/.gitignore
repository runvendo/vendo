# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Vendo store
/.vendo/data/
voice-e2e/

# fixtures/context-e2e and tests/vendo/away-drill each boot their own dev
# server. SIBLINGS of /.next/, never children: `next build` wipes its whole
# distDir, so a dist dir nested under the build's would be deleted out from
# under a concurrent run.
/.next-context-e2e/
/.next-away-drill/

{
  "openapi": "3.1.0",
  "info": {
    "title": "Maple Bank API",
    "description": "Maple's own REST API. This spec is the host contract Vendo's agent acts through, as the signed-in user (ENG-202).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/maple"
    }
  ],
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "List the user's bank accounts with balances.",
        "x-vendo-formats": {
          "balance": "cents"
        },
        "responses": {
          "200": {
            "description": "Accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Account"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Fetch one account by id.",
        "x-vendo-formats": {
          "balance": "cents"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account id, e.g. acct_checking"
          }
        ],
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Account"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/accounts/{id}/transactions": {
      "get": {
        "operationId": "listAccountTransactions",
        "summary": "List recent transactions for one account.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account id"
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "One page of transactions. The rows are `data.data`; the outer `data` is the API envelope.",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Transaction"
                          }
                        },
                        "nextCursor": {
                          "type": "string"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "data",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "operationId": "listTransactions",
        "summary": "Search and list transactions across all accounts, with filters, sorting and cursor pagination.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Free-text match on merchant/descriptor"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Category, e.g. dining, groceries, coffee, transport, subscriptions"
          },
          {
            "name": "accountId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "pending | authorized | posted"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO date lower bound"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO date upper bound"
          },
          {
            "name": "min",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Minimum absolute amount in cents"
          },
          {
            "name": "max",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Maximum absolute amount in cents"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "date_desc | date_asc | amount_desc | amount_asc"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "One page of transactions. The rows are `data.data`; the outer `data` is the API envelope.",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Transaction"
                          }
                        },
                        "nextCursor": {
                          "type": "string"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "data",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/{id}": {
      "get": {
        "operationId": "getTransaction",
        "summary": "Fetch one transaction by id, including its status timeline.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Transaction"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/cards": {
      "get": {
        "operationId": "listCards",
        "summary": "List the user's physical and virtual cards.",
        "responses": {
          "200": {
            "description": "Cards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Card"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/{id}/transactions": {
      "get": {
        "operationId": "listCardTransactions",
        "summary": "List recent transactions charged to one card.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Card id"
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "One page of transactions. The rows are `data.data`; the outer `data` is the API envelope.",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Transaction"
                          }
                        },
                        "nextCursor": {
                          "type": "string"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "data",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/payees": {
      "get": {
        "operationId": "listPayees",
        "summary": "List saved payees.",
        "responses": {
          "200": {
            "description": "Payees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Payee"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/goals": {
      "get": {
        "operationId": "listGoals",
        "summary": "List savings goals with progress.",
        "x-vendo-formats": {
          "target": "cents",
          "saved": "cents"
        },
        "responses": {
          "200": {
            "description": "Goals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Goal"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Fetch the signed-in user's profile.",
        "x-vendo-formats": {
          "netWorth": "cents"
        },
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "operationId": "listNotifications",
        "summary": "List recent account notifications.",
        "responses": {
          "200": {
            "description": "Notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notification"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/scheduled": {
      "get": {
        "operationId": "listScheduledPayments",
        "summary": "List upcoming scheduled payments.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "responses": {
          "200": {
            "description": "Scheduled payments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ScheduledPayment"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/insights/spending": {
      "get": {
        "operationId": "getSpendingInsights",
        "summary": "Spending by category for the current period.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "responses": {
          "200": {
            "description": "Spending breakdown: { data: [{ category, amount }] } — amount is integer cents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The spending slices live under `data` — the array itself is `data`, never the response body.",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "One slice per spending category, largest first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "dining",
                              "groceries",
                              "coffee",
                              "transport",
                              "subscriptions",
                              "shopping",
                              "income",
                              "transfer",
                              "housing",
                              "other"
                            ]
                          },
                          "amount": {
                            "type": "integer",
                            "description": "Amount spent in integer cents (e.g. 285000 = $2,850.00): divide by 100 exactly once before displaying, including any totals you compute."
                          }
                        },
                        "required": [
                          "category",
                          "amount"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/insights/cashflow": {
      "get": {
        "operationId": "getCashflowInsights",
        "summary": "Cash inflow/outflow summary.",
        "x-vendo-formats": {
          "in": "cents",
          "out": "cents"
        },
        "responses": {
          "200": {
            "description": "Cashflow: { data: [{ label, in, out }] } — in/out are integer cents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The cashflow periods live under `data` — the array itself is `data`, never the response body.",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "One entry per period, oldest first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "in": {
                            "type": "integer",
                            "description": "Money in for the period, in integer cents (e.g. 1284000 = $12,840.00): divide by 100 exactly once before displaying, including any totals you compute."
                          },
                          "out": {
                            "type": "integer",
                            "description": "Money out for the period, in integer cents: divide by 100 exactly once before displaying."
                          }
                        },
                        "required": [
                          "label",
                          "in",
                          "out"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/insights/budgets": {
      "get": {
        "operationId": "getBudgets",
        "summary": "Budgets with spend-to-date per category.",
        "x-vendo-formats": {
          "limit": "cents",
          "spent": "cents"
        },
        "responses": {
          "200": {
            "description": "Budgets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Budget"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/insights/recurring": {
      "get": {
        "operationId": "getRecurringInsights",
        "summary": "Detected recurring charges and subscriptions.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "responses": {
          "200": {
            "description": "Recurring charges",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Recurring"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Place a delivery order on the user's account. This MOVES MONEY: it charges the user's card and appends a transaction.",
        "x-vendo-formats": {
          "amount": "cents"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "merchant": {
                    "type": "string",
                    "description": "Merchant name, e.g. DoorDash"
                  },
                  "amountCents": {
                    "type": "number",
                    "description": "Charge amount in cents, e.g. 3184"
                  },
                  "descriptor": {
                    "type": "string",
                    "description": "Card statement descriptor"
                  },
                  "items": {
                    "type": "string",
                    "description": "Human-readable order contents"
                  },
                  "hour": {
                    "type": "number",
                    "description": "Order hour (0-23, Pacific). Demo default is late-night."
                  },
                  "minute": {
                    "type": "number",
                    "description": "Order minute (0-59)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The appended transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Transaction"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/transfers": {
      "post": {
        "operationId": "transferMoney",
        "summary": "Send money to a person from the user's checking account. This IRREVERSIBLY MOVES MONEY: it debits checking and appends a transfer. There is no undo.",
        "x-vendo-dangerous": true,
        "x-vendo-formats": {
          "amount": "cents"
        },
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Amount to send in cents (positive whole number), e.g. 50000 = $500.00"
          },
          {
            "name": "recipient_name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Who the money goes to, e.g. Alex Rivera"
          },
          {
            "name": "memo",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional note shown on the transfer, e.g. June rent"
          }
        ],
        "responses": {
          "200": {
            "description": "The appended transfer transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Transaction"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "actor": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "name"
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "dining",
          "groceries",
          "coffee",
          "transport",
          "subscriptions",
          "shopping",
          "income",
          "transfer",
          "housing",
          "other"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "checking",
              "savings",
              "credit",
              "investing"
            ]
          },
          "mask": {
            "type": "string"
          },
          "balance": {
            "type": "integer",
            "description": "Balance in integer cents: divide by 100 exactly once before displaying."
          },
          "accountNumber": {
            "type": "string"
          },
          "routingNumber": {
            "type": "string"
          },
          "apy": {
            "type": "number"
          },
          "sparkline": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "mask",
          "balance",
          "accountNumber",
          "sparkline"
        ]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "cardId": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "descriptor": {
            "type": "string"
          },
          "logo": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "description": "Amount in integer cents, negative for a debit: divide by 100 exactly once before displaying."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "status": {
            "type": "string",
            "enum": [
              "posted",
              "pending",
              "authorized"
            ]
          },
          "statusTimeline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "state",
                "at"
              ]
            }
          },
          "method": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "recurringId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "accountId",
          "merchant",
          "descriptor",
          "amount",
          "timestamp",
          "category",
          "status",
          "statusTimeline",
          "method"
        ]
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "physical",
              "virtual"
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "visa",
              "mastercard"
            ]
          },
          "mask": {
            "type": "string"
          },
          "expMonth": {
            "type": "integer"
          },
          "expYear": {
            "type": "integer"
          },
          "frozen": {
            "type": "boolean"
          },
          "spendLimit": {
            "type": "integer",
            "description": "Spend limit in integer cents."
          },
          "design": {
            "type": "string"
          }
        },
        "required": [
          "id",

    {
      "name": "host_listClientDocuments",
      "description": "List one client's requested tax documents (their checklist) with per-document status, uploaded file and any rejection note. Pass `to` to see it as it stood at a past instant: a document uploaded after `to` reads as missing. Verification and rejection are NOT timestamped, so verified/rejected state is always the current one — never state that a document was verified or rejected as of a past date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client id"
          },
          "from": {
            "type": "string",
            "description": "Unused for this snapshot read; accepted so an automation rehearsal can pin its firing window. ISO 8601 instant."
          },
          "to": {
            "type": "string",
            "description": "As-of instant (ISO 8601): return the checklist as it stood then. Only uploads are timestamped, so a document uploaded after this reads as missing; verified/rejected state is always the current one. Omit for live data."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Document request id, e.g. doc_rivera_w2"
                },
                "clientId": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "description": "What was requested, e.g. W-2, 1099-NEC, Bank statements (2025)"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "missing",
                    "received",
                    "needs_review",
                    "verified",
                    "rejected"
                  ],
                  "description": "Lifecycle: missing -> received (or needs_review if the upload looks wrong) -> verified; reject returns it to missing with a note"
                },
                "note": {
                  "type": "string",
                  "description": "Rejection or review note shown until the client re-uploads"
                },
                "file": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "uploadedAt": {
                      "type": "string",
                      "description": "ISO 8601"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "risk": "ungraded",
      "binding": {
        "kind": "openapi",
        "operationId": "listClientDocuments",
        "method": "GET",
        "path": "/cadence/api/clients/{id}/documents"
      },
      "srcHash": "sha256:29effa01006b4470f547300aab703daaef79ec5312e2eb87e4930ac3cf4b20ba"
    },

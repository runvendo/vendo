    {
      "name": "host_setDocumentStatus",
      "description": "Marks one of a client's requested documents as received, verified or rejected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client id"
          },
          "docId": {
            "type": "string",
            "description": "Document request id belonging to that client"
          },
          "body": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "receive",
                  "verify",
                  "reject"
                ],
                "description": "Lifecycle transition to apply: 'receive' marks a missing document as uploaded (attaching a file name), 'verify' confirms an uploaded document is correct, 'reject' returns a wrong upload to missing with a reason the client sees. Verify and reject only apply to documents in status received or needs_review."
              },
              "fileName": {
                "type": "string",
                "description": "Uploaded file name (receive only); a plausible default is generated if omitted"
              },
              "reason": {
                "type": "string",
                "description": "Why the document was rejected (reject only); shown to the client until they re-upload"
              }
            }
          }
        },
        "required": [
          "id",

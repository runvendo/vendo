        "data.data.statusTimeline.at": {
          "kind": "date",
          "format": "iso"
        },
        "data.data.accountId": {
          "kind": "id",
          "entity": "account"
        },
        "data.data.cardId": {
          "kind": "id",
          "entity": "card"
        },
        "data.data.amount": {
          "kind": "money",
          "unit": "cents"
        },
        "data.data.timestamp": {
          "kind": "date",
          "format": "iso"
        },
        "data.data.category": {

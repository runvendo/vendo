      },
      "srcHash": "sha256:16b1366a315696207861f0805d15f24bdc265568f62ffdcaf6b740fa2a48edc1"
    },
    {
      "name": "host_getClient",
      "description": "Fetch one client with document progress, derived status and assigned staff.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client id, e.g. cl_rivera"
          }
        },
        "required": [
          "id"
        ]
      },
      "risk": "read",
      "binding": {
        "kind": "openapi",
        "operationId": "getClient",
        "method": "GET",
        "path": "/api/clients/{id}"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Client id, e.g. cl_rivera"
              },
              "businessName": {
                "type": "string"
              },
              "entityType": {
                "type": "string",
                "enum": [
                  "s_corp",
                  "sole_prop",
                  "partnership",
                  "c_corp",
                  "individual"
                ]
              },
              "contactName": {
                "type": "string"
              },
              "contactEmail": {
                "type": "string"
              },
              "assigneeId": {
                "type": "string"
              },
              "assignee": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "initials": {
                    "type": "string"
                  }
                }
              },
              "filingDeadline": {
                "type": "string",
                "description": "ISO 8601 filing deadline"
              },
              "progress": {
                "type": "object",
                "description": "Document collection progress, rendered as e.g. '3 of 6 received'",
                "properties": {
                  "received": {
                    "type": "number",
                    "description": "Documents no longer missing or rejected"
                  },
                  "total": {
                    "type": "number"
                  }
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "missing_docs",
                  "in_review",
                  "complete"
                ],
                "description": "Derived from the client's documents"
              }
            }
          }
        }
      },
      "srcHash": "sha256:16b1366a315696207861f0805d15f24bdc265568f62ffdcaf6b740fa2a48edc1"
    },
    {
      "name": "host_getDashboard",
      "description": "Firm-wide dashboard metrics: how many clients are missing documents, documents outstanding vs received, and the nearest filing deadline with its client.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "risk": "read",
      "binding": {
        "kind": "openapi",
        "operationId": "getDashboard",
        "method": "GET",
        "path": "/api/dashboard"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "clientsMissingDocs": {
                "type": "number",
                "description": "Clients with at least one outstanding document"
              },
              "documentsOutstanding": {
                "type": "number",
                "description": "Documents still missing or rejected across all clients"
              },
              "documentsReceived": {
                "type": "number"
              },
              "documentsTotal": {
                "type": "number"
              },
              "clientsTotal": {
                "type": "number"
              },
              "nearestDeadline": {
                "type": "string",
                "description": "ISO 8601 date of the soonest client filing deadline; the dashboard counts down to this"
              },
              "nearestDeadlineClient": {
                "type": "object",
                "description": "The client whose deadline is soonest",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "businessName": {
                    "type": "string"
                  },
                  "filingDeadline": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "semantics": {
        "data.nearestDeadline": {
          "kind": "date",
          "format": "iso"
        },
        "data.nearestDeadlineClient.id": {
          "kind": "id"
        },
        "data.nearestDeadlineClient.filingDeadline": {
          "kind": "date",
          "format": "iso"
        }
      },
      "srcHash": "sha256:16b1366a315696207861f0805d15f24bdc265568f62ffdcaf6b740fa2a48edc1"
    },
    {
      "name": "host_listActivity",
      "description": "Firm-wide activity feed, newest first: uploads received, documents verified or rejected, messages sent, deadlines approaching.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Maximum number of events to return; omit for the full feed"
          }
        }
      },
      "risk": "read",
      "binding": {
        "kind": "openapi",
        "operationId": "listActivity",
        "method": "GET",
        "path": "/api/activity"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "upload_received",
                    "document_verified",
                    "document_rejected",
                    "message_sent",
                    "deadline_approaching"
                  ]
                },
                "clientId": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "description": "ISO 8601"
                }
              }
            }
          }
        }
      },
      "semantics": {
        "data.id": {
          "kind": "id"
        },
        "data.type": {
          "kind": "enum",
          "labels": {
            "deadline_approaching": "Deadline approaching",
            "document_rejected": "Document rejected",
            "document_verified": "Document verified",
            "message_sent": "Message sent",
            "upload_received": "Upload received"
          }
        },
        "data.clientId": {
          "kind": "id",
          "entity": "client"
        },
        "data.at": {
          "kind": "date",
          "format": "iso"
        }
      },
      "srcHash": "sha256:16b1366a315696207861f0805d15f24bdc265568f62ffdcaf6b740fa2a48edc1"
    },
    {
      "name": "host_listClientDocuments",
      "description": "List one client's requested tax documents (their checklist) with per-document status, uploaded file and any rejection note.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client id"
          }
        },
        "required": [
          "id"
        ]
      },
      "risk": "read",
      "binding": {
        "kind": "openapi",
        "operationId": "listClientDocuments",
        "method": "GET",
        "path": "/api/clients/{id}/documents"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Document request id, e.g. doc_rivera_w2"
                },
                "clientId": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "description": "What was requested, e.g. W-2, 1099-NEC, Bank statements (2025)"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "missing",
                    "received",
                    "needs_review",
                    "verified",
                    "rejected"
                  ],
                  "description": "Lifecycle: missing -> received (or needs_review if the upload looks wrong) -> verified; reject returns it to missing with a note"
                },
                "note": {
                  "type": "string",
                  "description": "Rejection or review note shown until the client re-uploads"
                },
                "file": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "uploadedAt": {
                      "type": "string",
                      "description": "ISO 8601"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "srcHash": "sha256:16b1366a315696207861f0805d15f24bdc265568f62ffdcaf6b740fa2a48edc1"
    },

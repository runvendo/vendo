{
  "app": "Atlas, an issue tracker for software teams",
  "theme": {
    "colors": {
      "background": "#0E0E14",
      "surface": "#16161F",
      "text": "#ECECF2",
      "muted": "#8A8AA0",
      "accent": "#7C5CFF",
      "accentText": "#FFFFFF",
      "danger": "#F2555A",
      "border": "#26263A"
    },
    "typography": { "fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif", "baseSize": "13px" },
    "radius": { "small": "4px", "medium": "6px", "large": "8px" },
    "density": "compact",
    "motion": "full"
  },
  "style": [
    "uses the theme exactly: dark violet surfaces, the theme's sans stack, 4-6px corners — no invented colors, no serif or display type",
    "dense like a keyboard-driven tracker: compact rows, small type, no hero whitespace and no oversized cards",
    "status and priority read as short color-coded badges, never as sentences",
    "task rows lead with their ATL key, and estimates read as '5 pts'",
    "dates read as 'Aug 7', never ISO",
    "destructive actions ask for confirmation before they fire"
  ],
  "tools": {
    "list_sprints": {
      "does": "Every cycle the team has planned, newest first. The rows are the `data` array. `committedPoints` is the whole estimate in the cycle and `completedPoints` is the part already finished — both are story points, never hours. `state` is one of planned, active, completed. Dates are ISO.",

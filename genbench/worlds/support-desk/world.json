    "get_ticket": {
      "does": "One ticket with its whole conversation and who the customer is, as the single row of the `data` array. The canned response always answers with TK-1040, whatever `id` is passed. `messages` runs oldest first; `author_kind` is `customer` or `agent`. `order_total_cents` and `customer_lifetime_spend_cents` are in CENTS: 32400 is $324.00.",
      "takes": { "id": "string" },
      "data": {
        "data": [{
          "id": "TK-1040",
          "subject": "Wrong item shipped, I ordered walnut and got oak",
          "customer": "Dominic Reyes",
          "email": "dominic.reyes@saltmarsh.io",
          "channel": "email",
          "status": "open",
          "priority": "high",
          "assignee": "ag_nadia",
          "assignee_name": "Nadia Okafor",
          "tags": ["wrong-item", "exchange", "repeat-buyer"],
          "order_total_cents": 32400,
          "customer_lifetime_orders": 4,
          "customer_lifetime_spend_cents": 118600,
          "created_at": "2026-08-10T08:12:00Z",
          "updated_at": "2026-08-12T13:37:00Z",
          "first_reply_minutes": 168,
          "sla_due_at": "2026-08-11T08:12:00Z",
          "sla_minutes_remaining": -1858,
          "sla_paused": false,
          "sla_breached": true,
          "messages": [
            {
              "id": "msg_a",
              "author_kind": "customer",
              "author": "Dominic Reyes",
              "sent_at": "2026-08-10T08:12:00Z",
              "body": "I ordered the walnut wall shelf and an oak one turned up instead. Same size, wrong wood. Can we swap it?"
            },
            {
              "id": "msg_b",
              "author_kind": "agent",
              "author": "Nadia Okafor",
              "sent_at": "2026-08-10T11:00:00Z",
              "body": "Sorry about that, Dominic. I have the walnut one held for you. A photo of what arrived would help me file it with the warehouse."
            },
            {
              "id": "msg_c",
              "author_kind": "customer",
              "author": "Dominic Reyes",
              "sent_at": "2026-08-11T07:26:00Z",
              "body": "Photos attached. Do I have to pay to send the oak one back?"
            },
            {
              "id": "msg_d",
              "author_kind": "agent",
              "author": "Nadia Okafor",
              "sent_at": "2026-08-12T13:37:00Z",
              "body": "Never. A prepaid return label is in your inbox, and the walnut shelf ships the moment that label scans."
            }
          ]
        }]
      }
    },

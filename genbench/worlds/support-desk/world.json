{
  "app": "Perch, a shared-inbox support helpdesk for a small e-commerce team",
  "theme": {
    "colors": {
      "background": "#F4F5F7",
      "surface": "#FFFFFF",
      "text": "#14161A",
      "muted": "#5C6270",
      "accent": "#4B36D9",
      "accentText": "#FFFFFF",
      "danger": "#E02D3C",
      "border": "#DCDFE6"
    },
    "typography": { "fontFamily": "Onest, sans-serif", "baseSize": "13px" },
    "radius": { "small": "3px", "medium": "5px", "large": "5px" },
    "density": "compact",
    "motion": "reduced"
  },
  "style": [
    "uses the theme exactly: the indigo accent, Onest, near-square 3-5px corners on a grey canvas with white cards — no invented colors or fonts",
    "dense by default: compact rows, small type, no oversized hero headings — an agent stares at this all day",
    "ticket status and priority read as small labelled chips, never as bare words in a cell",
    "red is reserved for SLA trouble — overdue and breached only; nothing else on the screen is red",
    "money always shows 2 decimals with a currency symbol",
    "timestamps read as 'Aug 10, 8:12 AM' or '2h ago', and SLA clocks as '2h 38m left' or 'overdue 1h 55m' — never ISO, never a raw minute count"
  ],
  "tools": {
    "list_tickets": {
      "does": "The shared inbox: every ticket that has not been closed yet — the active ones AND the recently solved ones, which stay in the inbox until somebody closes them — newest first by `created_at`. The rows are the `data` array. `order_total_cents` is in CENTS: 32400 is $324.00, and 0 means no order is attached to the ticket. `assignee` and `assignee_name` are empty strings when nobody owns the ticket. `first_reply_minutes` is 0 when the customer has not been answered yet. SLA targets run wall-clock from `created_at` — urgent 4h, high 24h, normal 48h, low 5 days — so `sla_due_at` is the resolution deadline; `sla_minutes_remaining` is measured from now, 2026-08-12T15:10:00Z, is negative when the ticket is already overdue, and is 0 once a ticket is `solved`: the clock no longer applies. The clock pauses while a ticket is `pending` (waiting on the customer), which is what `sla_paused` marks: those rows' remaining minutes are frozen at the moment they went pending, and they are never counted as breached.",
      "takes": { "limit": "number" },

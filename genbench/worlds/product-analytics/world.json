{
  "app": "Waypost, a product-analytics workspace where software teams watch events, funnels, retention cohorts and segments",
  "theme": {
    "colors": {
      "background": "#0B0F14",
      "surface": "#131A22",
      "text": "#E6EDF3",
      "muted": "#8B9AAA",
      "accent": "#00D3A7",
      "accentText": "#04231C",
      "danger": "#FF6B6B",
      "border": "#232D38"
    },
    "typography": { "fontFamily": "Inter, sans-serif", "baseSize": "13px" },
    "radius": { "small": "3px", "medium": "4px", "large": "6px" },
    "density": "compact",
    "motion": "reduced"
  },
  "style": [
    "uses the theme exactly: the near-black #0B0F14 canvas, mint #00D3A7 accent and Inter — no invented colors or fonts",
    "the number is the loudest thing in any panel: metrics set large in tabular figures, their label small and muted #8B9AAA beside them",
    "panels are divided by 1px #232D38 hairlines and corners stay nearly square (3-6px) — no drop shadows, no pill-shaped cards",
    "figures are formatted for scanning: counts with thousands separators (12,480), percentages to one decimal with a % sign, money with a $ and two decimals",
    "every metric names the window it covers — 'last 7 days', 'last 30 days', 'Aug 11' — right beside the number",
    "dates read 'Aug 11' or 'Jul 20 – Jul 26', never ISO"
  ],
  "tools": {
    "list_events": {
      "does": "Every event in the workspace's tracking plan, busiest first. The rows are the `data` array. `volume_7d` and `volume_30d` are how many times the event fired, `unique_users_7d` is the people behind the last 7 days, and `status` is one of live, unverified or deprecated.",
      "data": {
        "data": [
          { "id": "evt_app_opened", "name": "app_opened", "category": "core", "status": "live", "volume_7d": 128940, "volume_30d": 548600, "unique_users_7d": 16842, "last_seen": "2026-08-11" },
          { "id": "evt_sidebar_collapsed", "name": "sidebar_collapsed", "category": "ui", "status": "unverified", "volume_7d": 9402, "volume_30d": 41880, "unique_users_7d": 6120, "last_seen": "2026-08-11" },
          { "id": "evt_onboarding_step_viewed", "name": "onboarding_step_viewed", "category": "onboarding", "status": "live", "volume_7d": 5120, "volume_30d": 21480, "unique_users_7d": 1204, "last_seen": "2026-08-11" },
          { "id": "evt_pricing_page_viewed", "name": "pricing_page_viewed", "category": "marketing", "status": "live", "volume_7d": 3612, "volume_30d": 15240, "unique_users_7d": 2988, "last_seen": "2026-08-11" },
          { "id": "evt_report_exported", "name": "report_exported", "category": "engagement", "status": "live", "volume_7d": 2145, "volume_30d": 9880, "unique_users_7d": 806, "last_seen": "2026-08-10" },
          { "id": "evt_signup_completed", "name": "signup_completed", "category": "lifecycle", "status": "live", "volume_7d": 1502, "volume_30d": 5604, "unique_users_7d": 1502, "last_seen": "2026-08-11" },
          { "id": "evt_checkout_started", "name": "checkout_started", "category": "revenue", "status": "live", "volume_7d": 962, "volume_30d": 4010, "unique_users_7d": 918, "last_seen": "2026-08-11" },
          { "id": "evt_invite_sent", "name": "invite_sent", "category": "collaboration", "status": "live", "volume_7d": 806, "volume_30d": 3520, "unique_users_7d": 402, "last_seen": "2026-08-11" },
          { "id": "evt_workspace_created", "name": "workspace_created", "category": "lifecycle", "status": "live", "volume_7d": 468, "volume_30d": 1980, "unique_users_7d": 441, "last_seen": "2026-08-11" },
          { "id": "evt_checkout_completed", "name": "checkout_completed", "category": "revenue", "status": "live", "volume_7d": 318, "volume_30d": 1344, "unique_users_7d": 311, "last_seen": "2026-08-11" },
          { "id": "evt_csv_import_finished", "name": "csv_import_finished", "category": "integrations", "status": "live", "volume_7d": 0, "volume_30d": 96, "unique_users_7d": 0, "last_seen": "2026-07-19" },
          { "id": "evt_old_pricing_toggle", "name": "old_pricing_toggle", "category": "experiment", "status": "unverified", "volume_7d": 0, "volume_30d": 0, "unique_users_7d": 0, "last_seen": "2026-05-30" },
          { "id": "evt_legacy_signup_v1", "name": "legacy_signup_v1", "category": "lifecycle", "status": "deprecated", "volume_7d": 0, "volume_30d": 0, "unique_users_7d": 0, "last_seen": "2026-04-18" }
        ]
      }
    },
    "get_event_properties": {
      "does": "How one event's fires break down by property value over the last 30 days: `count` is fires, `share_pct` is that value's share of the event's 30-day volume. The rows are the `data` array — this response is `checkout_started`, whose 30-day volume is 4010.",
      "takes": { "event_name": "string" },
      "data": {
        "data": [
          { "event_id": "evt_checkout_started", "property": "plan", "value": "pro", "count": 1848, "share_pct": 46.1 },
          { "event_id": "evt_checkout_started", "property": "plan", "value": "team", "count": 1284, "share_pct": 32.0 },
          { "event_id": "evt_checkout_started", "property": "plan", "value": "starter", "count": 878, "share_pct": 21.9 },
          { "event_id": "evt_checkout_started", "property": "source", "value": "web", "count": 3126, "share_pct": 78.0 },
          { "event_id": "evt_checkout_started", "property": "source", "value": "mobile", "count": 884, "share_pct": 22.0 },
          { "event_id": "evt_checkout_started", "property": "country", "value": "US", "count": 2405, "share_pct": 60.0 },
          { "event_id": "evt_checkout_started", "property": "country", "value": "GB", "count": 522, "share_pct": 13.0 },
          { "event_id": "evt_checkout_started", "property": "country", "value": "DE", "count": 401, "share_pct": 10.0 },
          { "event_id": "evt_checkout_started", "property": "country", "value": "other", "count": 682, "share_pct": 17.0 }
        ]
      }
    },
    "get_event_paths": {
      "does": "What people do next after one event, as a branching tree over the last 7 days. The rows are the `data` array — this response is `app_opened`, which 16842 people fired. `from_event` is the branch's parent, `step` is how far past the root it sits, `users` is the people who took it and `pct_of_parent` their share of the parent. `(drop-off)` is the branch that ends the session. Only the branches worth opening are returned.",
      "takes": { "event_name": "string" },
      "data": {
        "data": [
          { "from_event": "app_opened", "step": 1, "event_name": "onboarding_step_viewed", "users": 4980, "pct_of_parent": 29.6 },
          { "from_event": "app_opened", "step": 1, "event_name": "(drop-off)", "users": 4002, "pct_of_parent": 23.8 },
          { "from_event": "app_opened", "step": 1, "event_name": "sidebar_collapsed", "users": 3120, "pct_of_parent": 18.5 },
          { "from_event": "app_opened", "step": 1, "event_name": "report_exported", "users": 2650, "pct_of_parent": 15.7 },
          { "from_event": "app_opened", "step": 1, "event_name": "pricing_page_viewed", "users": 2090, "pct_of_parent": 12.4 },
          { "from_event": "onboarding_step_viewed", "step": 2, "event_name": "(drop-off)", "users": 2552, "pct_of_parent": 51.2 },
          { "from_event": "onboarding_step_viewed", "step": 2, "event_name": "workspace_created", "users": 1806, "pct_of_parent": 36.3 },
          { "from_event": "onboarding_step_viewed", "step": 2, "event_name": "invite_sent", "users": 622, "pct_of_parent": 12.5 },
          { "from_event": "pricing_page_viewed", "step": 2, "event_name": "(drop-off)", "users": 1348, "pct_of_parent": 64.5 },
          { "from_event": "pricing_page_viewed", "step": 2, "event_name": "checkout_started", "users": 742, "pct_of_parent": 35.5 },
          { "from_event": "checkout_started", "step": 3, "event_name": "(drop-off)", "users": 424, "pct_of_parent": 57.1 },
          { "from_event": "checkout_started", "step": 3, "event_name": "checkout_completed", "users": 318, "pct_of_parent": 42.9 }
        ]
      }
    },
    "list_funnels": {
      "does": "Every saved funnel with how many people entered it and its end-to-end conversion over `window`. The rows are the `data` array. `steps` is how many steps the funnel has. Every step of every funnel is built on an event already in the tracking plan: Trial to paid checkout on checkout_started, pricing_page_viewed and checkout_completed, First teammate invited on workspace_created, app_opened and invite_sent.",
      "data": {
        "data": [
          { "id": "fnl_onboarding", "name": "New workspace onboarding", "steps": 5, "users_entered": 5604, "conversion_pct": 7.4, "window": "last 30 days", "owner": "priya.raman@waypost.example", "updated": "2026-08-06" },
          { "id": "fnl_checkout", "name": "Trial to paid checkout", "steps": 3, "users_entered": 4010, "conversion_pct": 33.5, "window": "last 30 days", "owner": "marcus.hale@waypost.example", "updated": "2026-08-09" },
          { "id": "fnl_invite", "name": "First teammate invited", "steps": 3, "users_entered": 1980, "conversion_pct": 27.1, "window": "last 30 days", "owner": "dana.okonkwo@waypost.example", "updated": "2026-07-28" }
        ]
      }
    },
    "get_funnel_steps": {
      "does": "The steps of one funnel in order: `users` reached the step, `conversion_from_previous_pct` is its share of the step above it, and `median_minutes_to_next` is null on the last step. The rows are the `data` array — this response is the New workspace onboarding funnel, `fnl_onboarding`.",
      "takes": { "funnel_id": "string" },
      "data": {
        "data": [
          { "id": "stp_ob_signed_up", "funnel_id": "fnl_onboarding", "position": 1, "name": "Signed up", "event_name": "signup_completed", "users": 5604, "conversion_from_previous_pct": 100.0, "median_minutes_to_next": 3.5 },
          { "id": "stp_ob_viewed_onboarding", "funnel_id": "fnl_onboarding", "position": 2, "name": "Viewed onboarding", "event_name": "onboarding_step_viewed", "users": 4062, "conversion_from_previous_pct": 72.5, "median_minutes_to_next": 6.2 },
          { "id": "stp_ob_created_workspace", "funnel_id": "fnl_onboarding", "position": 3, "name": "Created a workspace", "event_name": "workspace_created", "users": 1424, "conversion_from_previous_pct": 35.1, "median_minutes_to_next": 41.8 },
          { "id": "stp_ob_invited_teammate", "funnel_id": "fnl_onboarding", "position": 4, "name": "Invited a teammate", "event_name": "invite_sent", "users": 536, "conversion_from_previous_pct": 37.6, "median_minutes_to_next": 128.4 },
          { "id": "stp_ob_exported_report", "funnel_id": "fnl_onboarding", "position": 5, "name": "Exported a report", "event_name": "report_exported", "users": 414, "conversion_from_previous_pct": 77.2, "median_minutes_to_next": null }
        ]
      }
    },

      "data": {
        "data": [
          { "id": "pt_bell", "name": "Marcus Bell", "age": 46, "email": "marcus.bell@brightmail.com", "insurer": "Vale Health PPO", "balance": 4250, "last_visit": "2026-05-19", "provider_id": "prv_okafor" },

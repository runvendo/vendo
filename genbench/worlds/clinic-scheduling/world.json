        ]
      }
    },
    "get_open_slots": {
      "does": "The bookable openings left in one clinic day, earliest first — an opening whose time has already passed cannot be booked and is not listed. The rows are the `data` array. `minutes` is how long the opening is, and `opened_by` names the appointment whose cancellation freed it, or is empty when the opening was never booked.",
      "takes": { "date": "string" },
      "data": {
        "data": [
          { "id": "slot_301", "provider_id": "prv_tam", "provider": "Alice Tam, NP", "room_id": "room_309", "time": "12:40 PM", "start": "2026-08-12T12:40:00", "minutes": 20, "opened_by": "" },
          { "id": "slot_302", "provider_id": "prv_okafor", "provider": "Dr. Nia Okafor", "room_id": "room_302", "time": "1:15 PM", "start": "2026-08-12T13:15:00", "minutes": 30, "opened_by": "" },
          { "id": "slot_303", "provider_id": "prv_okafor", "provider": "Dr. Nia Okafor", "room_id": "room_302", "time": "2:00 PM", "start": "2026-08-12T14:00:00", "minutes": 20, "opened_by": "" },
          { "id": "slot_304", "provider_id": "prv_raman", "provider": "Dr. Priya Raman", "room_id": "room_307", "time": "2:10 PM", "start": "2026-08-12T14:10:00", "minutes": 25, "opened_by": "apt_1052" },
          { "id": "slot_305", "provider_id": "prv_lindqvist", "provider": "Dr. Sven Lindqvist", "room_id": "room_305", "time": "2:30 PM", "start": "2026-08-12T14:30:00", "minutes": 30, "opened_by": "" },
          { "id": "slot_306", "provider_id": "prv_raman", "provider": "Dr. Priya Raman", "room_id": "room_307", "time": "3:05 PM", "start": "2026-08-12T15:05:00", "minutes": 25, "opened_by": "" },
          { "id": "slot_307", "provider_id": "prv_tam", "provider": "Alice Tam, NP", "room_id": "room_309", "time": "3:35 PM", "start": "2026-08-12T15:35:00", "minutes": 40, "opened_by": "" }
        ]
      }
    },
    "list_providers": {
      "does": "The providers seeing patients today, each with the room they work out of. The rows are the `data` array. `booked_minutes` is today's booked visit time, cancellations excluded; `open_minutes` is the time still bookable today; `appointments_today` counts today's appointments, cancellations excluded.",
      "data": {
        "data": [
          { "id": "prv_okafor", "name": "Dr. Nia Okafor", "specialty": "Family Medicine", "room_id": "room_302", "appointments_today": 4, "booked_minutes": 115, "open_minutes": 50, "accepting_new": true },
          { "id": "prv_lindqvist", "name": "Dr. Sven Lindqvist", "specialty": "Dermatology", "room_id": "room_305", "appointments_today": 3, "booked_minutes": 80, "open_minutes": 30, "accepting_new": true },
          { "id": "prv_raman", "name": "Dr. Priya Raman", "specialty": "Pediatrics", "room_id": "room_307", "appointments_today": 2, "booked_minutes": 45, "open_minutes": 50, "accepting_new": true },
          { "id": "prv_tam", "name": "Alice Tam, NP", "specialty": "Walk-in Care", "room_id": "room_309", "appointments_today": 2, "booked_minutes": 40, "open_minutes": 60, "accepting_new": true }
        ]
      }
    },
    "list_patients": {

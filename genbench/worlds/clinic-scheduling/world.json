{
  "app": "Alder, the front-desk scheduling app for a multi-provider outpatient clinic",
  "theme": {
    "colors": {
      "background": "#F2F6F8",
      "surface": "#FFFFFF",
      "text": "#132A34",
      "muted": "#5B7484",
      "accent": "#0F7C8A",
      "accentText": "#FFFFFF",
      "danger": "#A93B4B",
      "border": "#DAE4EA"
    },
    "typography": { "fontFamily": "Poppins, sans-serif", "baseSize": "14px" },
    "radius": { "small": "6px", "medium": "12px", "large": "20px" },
    "density": "compact",
    "motion": "reduced"
  },
  "style": [
    "uses the theme exactly: Alder teal accent, Poppins, softly rounded cards on a cool grey page — no invented colors or fonts",
    "every appointment status is a labelled pill — 'Checked in', 'In room', 'No-show' — never color on its own",
    "times read as '9:15 AM' and dates as 'Aug 12', or 'Sep 5, 2025' where the year matters — never ISO, never 24-hour",
    "money always shows 2 decimals with a currency symbol",
    "an appointment's time never appears without the patient it belongs to — an open slot has no patient and needs none",
    "anything that cancels a visit or marks a no-show asks for confirmation first"
  ],
  "tools": {
    "list_appointments": {
      "does": "One clinic day's appointments, earliest first. The rows are the `data` array. `time` is the display time of `start`, `minutes` is the visit length, `copay` is in CENTS: 2500 is $25.00. `status` is one of scheduled, checked-in, in-room, completed, no-show, cancelled. `confirmed` says whether the patient answered a reminder. Today is 2026-08-12 and it is about 11:15 AM.",
      "takes": { "date": "string" },
      "data": {
        "data": [
          { "id": "apt_1041", "patient_id": "pt_bell", "patient": "Marcus Bell", "provider_id": "prv_okafor", "provider": "Dr. Nia Okafor", "room_id": "room_302", "time": "8:20 AM", "start": "2026-08-12T08:20:00", "minutes": 20, "visit_type": "follow-up", "status": "completed", "copay": 2500, "confirmed": true },
          { "id": "apt_1042", "patient_id": "pt_halloran", "patient": "Gwen Halloran", "provider_id": "prv_lindqvist", "provider": "Dr. Sven Lindqvist", "room_id": "room_305", "time": "9:15 AM", "start": "2026-08-12T09:15:00", "minutes": 30, "visit_type": "skin check", "status": "completed", "copay": 3500, "confirmed": true },
          { "id": "apt_1043", "patient_id": "pt_vasquez", "patient": "Theo Vasquez", "provider_id": "prv_okafor", "provider": "Dr. Nia Okafor", "room_id": "room_302", "time": "9:45 AM", "start": "2026-08-12T09:45:00", "minutes": 30, "visit_type": "new patient", "status": "in-room", "copay": 5000, "confirmed": true },
          { "id": "apt_1044", "patient_id": "pt_nakamura", "patient": "Sofia Nakamura", "provider_id": "prv_raman", "provider": "Dr. Priya Raman", "room_id": "room_307", "time": "9:55 AM", "start": "2026-08-12T09:55:00", "minutes": 20, "visit_type": "well-child", "status": "completed", "copay": 1500, "confirmed": true },
          { "id": "apt_1045", "patient_id": "pt_fry", "patient": "Desmond Fry", "provider_id": "prv_lindqvist", "provider": "Dr. Sven Lindqvist", "room_id": "room_305", "time": "10:15 AM", "start": "2026-08-12T10:15:00", "minutes": 20, "visit_type": "biopsy follow-up", "status": "no-show", "copay": 3500, "confirmed": false },
          { "id": "apt_1046", "patient_id": "pt_ozawa", "patient": "Ruth Ozawa", "provider_id": "prv_okafor", "provider": "Dr. Nia Okafor", "room_id": "room_302", "time": "10:35 AM", "start": "2026-08-12T10:35:00", "minutes": 20, "visit_type": "medication review", "status": "checked-in", "copay": 2500, "confirmed": true },
          { "id": "apt_1047", "patient_id": "pt_brandt", "patient": "Eli Brandt", "provider_id": "prv_raman", "provider": "Dr. Priya Raman", "room_id": "room_307", "time": "10:45 AM", "start": "2026-08-12T10:45:00", "minutes": 25, "visit_type": "sick visit", "status": "checked-in", "copay": 1500, "confirmed": true },
          { "id": "apt_1048", "patient_id": "pt_vogel", "patient": "Corinne Vogel", "provider_id": "prv_tam", "provider": "Alice Tam, NP", "room_id": "room_309", "time": "11:10 AM", "start": "2026-08-12T11:10:00", "minutes": 20, "visit_type": "walk-in", "status": "in-room", "copay": 5000, "confirmed": true },
          { "id": "apt_1049", "patient_id": "pt_osei", "patient": "Amara Osei", "provider_id": "prv_okafor", "provider": "Dr. Nia Okafor", "room_id": "room_302", "time": "11:25 AM", "start": "2026-08-12T11:25:00", "minutes": 45, "visit_type": "annual physical", "status": "scheduled", "copay": 4000, "confirmed": false },
          { "id": "apt_1050", "patient_id": "pt_bragg", "patient": "Owen Bragg", "provider_id": "prv_lindqvist", "provider": "Dr. Sven Lindqvist", "room_id": "room_305", "time": "1:40 PM", "start": "2026-08-12T13:40:00", "minutes": 30, "visit_type": "acne consult", "status": "scheduled", "copay": 3500, "confirmed": false },
          { "id": "apt_1051", "patient_id": "pt_iyer", "patient": "Sam Iyer", "provider_id": "prv_tam", "provider": "Alice Tam, NP", "room_id": "room_309", "time": "1:50 PM", "start": "2026-08-12T13:50:00", "minutes": 20, "visit_type": "walk-in", "status": "scheduled", "copay": 5000, "confirmed": false },

        ]
      }
    },
    "get_job_pnl": {
      "does": "Profit and loss for every job with costs posted, worst margin first. The rows are the `data` array. `contract` is the quoted value, `material_cost` covers purchased material, rentals and other direct job cost, and `total_cost` is the three cost columns added up — it equals the job's cost to date. `margin` is contract minus total cost and is negative on a job that lost money; `margin_pct` is that margin as a percent of contract, one decimal. Money is in CENTS: 222400 is $2,224.00. Jobs with nothing posted yet are not in here.",
      "data": {
        "data": [
          { "job": "J-2377", "customer": "Kirkwood Elementary School District", "contract": 8420000, "labor_cost": 2531400, "material_cost": 4128600, "sub_cost": 2244600, "total_cost": 8904600, "margin": -484600, "margin_pct": -5.8 },
          { "job": "J-2418", "customer": "Harbor Point Dental", "contract": 3980000, "labor_cost": 1455200, "material_cost": 1982400, "sub_cost": 320000, "total_cost": 3757600, "margin": 222400, "margin_pct": 5.6 },
          { "job": "J-2395", "customer": "Vance Residence", "contract": 2975000, "labor_cost": 927300, "material_cost": 1191700, "sub_cost": 185000, "total_cost": 2304000, "margin": 671000, "margin_pct": 22.6 },
          { "job": "J-2402", "customer": "Larkspur Apartments LLC", "contract": 12600000, "labor_cost": 3239400, "material_cost": 4185900, "sub_cost": 1250000, "total_cost": 8675300, "margin": 3924700, "margin_pct": 31.1 },
          { "job": "J-2440", "customer": "Sutter Street Lofts HOA", "contract": 640000, "labor_cost": 285600, "material_cost": 75050, "sub_cost": 0, "total_cost": 360650, "margin": 279350, "margin_pct": 43.6 },
          { "job": "J-2431", "customer": "Ellis & Fern Bakery", "contract": 1840000, "labor_cost": 271500, "material_cost": 519600, "sub_cost": 0, "total_cost": 791100, "margin": 1048900, "margin_pct": 57 }
        ]
      }
    },
    "list_invoices": {
      "does": "Every invoice raised against a job, newest first. The rows are the `data` array. `status` is the payment state — sent, partial or paid. `days_late` is how many days past its due date the unpaid balance is, and is 0 when nothing is outstanding or the due date has not passed. `amount` and `balance` are in CENTS: 1990000 is $19,900.00.",
      "takes": { "limit": "number" },
      "data": {
        "data": [
          { "id": "INV-1051", "job": "J-2440", "customer": "Sutter Street Lofts HOA", "issued": "2026-08-05", "due": "2026-09-04", "amount": 320000, "balance": 320000, "status": "sent", "days_late": 0 },
          { "id": "INV-1042", "job": "J-2418", "customer": "Harbor Point Dental", "issued": "2026-07-30", "due": "2026-08-29", "amount": 1990000, "balance": 1990000, "status": "sent", "days_late": 0 },

{
  "app": "Plumbline, the job-costing books for trades contractors — kept here by Ridgeline Mechanical, an eleven-person plumbing and HVAC shop.",
  "theme": {
    "colors": {
      "background": "#EDEFF2",
      "surface": "#FFFFFF",
      "text": "#12171C",
      "muted": "#5B6774",
      "accent": "#E8B10B",
      "accentText": "#171200",
      "danger": "#B3261E",
      "border": "#D3D9E0"
    },
    "typography": { "fontFamily": "Inter, sans-serif", "baseSize": "15px" },
    "radius": { "small": "4px", "medium": "6px", "large": "10px" },
    "density": "comfortable",
    "motion": "reduced"
  },
  "style": [
    "uses the theme exactly: concrete-gray page, white cards, hi-vis amber buttons with near-black label text, Inter, 4-10px corners — no invented colors or fonts",
    "money always shows 2 decimals with a $ symbol, a loss shows in the danger red with a minus sign, and an unpaid invoice balance shows in the danger color",
    "every job is named by its job number and its customer together — 'J-2418 · Harbor Point Dental' — never a bare id",
    "hours read with one decimal and an h — '9.5 h' — and are never dressed up as money",
    "anything that bills a customer, approves payroll or writes an expense asks for confirmation first",
    "dates read as 'Aug 4' style, never ISO"
  ],
  "tools": {
    "list_jobs": {
      "does": "Every job on the board, newest job number first. The rows are the `data` array. `status` is one of scheduled, in_progress, awaiting_parts, complete_unbilled, closed. `start_date` is the day the crew started, or is due to start on a scheduled job. `quoted_hours` is the labor hours the estimate carried and `actual_hours` is the approved hours posted against the job so far. `quoted`, `cost_to_date`, `invoiced` and `to_invoice` are in CENTS: 3980000 is $39,800.00. `to_invoice` is what is left of the quote to bill.",
      "data": {
        "data": [
          { "id": "J-2444", "customer": "Delaney Auto Body", "contact": "Chris Delaney", "site": "Kessler Avenue Shop", "work": "Compressed air lines and a new water heater", "status": "scheduled", "foreman": "Rudy Okafor", "start_date": "2026-08-17", "quoted": 1320000, "quoted_hours": 96, "actual_hours": 0, "cost_to_date": 0, "invoiced": 0, "to_invoice": 1320000 },
          { "id": "J-2440", "customer": "Sutter Street Lofts HOA", "contact": "Dana Prokop", "site": "Sutter Street Lofts", "work": "Boiler service contract, summer visits", "status": "in_progress", "foreman": "Marco Deleon", "start_date": "2026-06-15", "quoted": 640000, "quoted_hours": 40, "actual_hours": 44, "cost_to_date": 360650, "invoiced": 640000, "to_invoice": 0 },
          { "id": "J-2431", "customer": "Ellis & Fern Bakery", "contact": "Owen Ellis", "site": "Halsted Row", "work": "Grease trap and floor drains", "status": "awaiting_parts", "foreman": "Rudy Okafor", "start_date": "2026-07-29", "quoted": 1840000, "quoted_hours": 64, "actual_hours": 41, "cost_to_date": 791100, "invoiced": 0, "to_invoice": 1840000 },
          { "id": "J-2418", "customer": "Harbor Point Dental", "contact": "Dr. Alina Fassbender", "site": "Harbor Point Plaza", "work": "Rooftop unit replacement and duct tie-in", "status": "in_progress", "foreman": "Marco Deleon", "start_date": "2026-07-24", "quoted": 3980000, "quoted_hours": 180, "actual_hours": 214, "cost_to_date": 3757600, "invoiced": 1990000, "to_invoice": 1990000 },
          { "id": "J-2402", "customer": "Larkspur Apartments LLC", "contact": "Miriam Cole", "site": "Larkspur Way", "work": "Domestic water repipe, all units", "status": "in_progress", "foreman": "Rudy Okafor", "start_date": "2026-06-08", "quoted": 12600000, "quoted_hours": 520, "actual_hours": 486, "cost_to_date": 8675300, "invoiced": 8400000, "to_invoice": 4200000 },
          { "id": "J-2395", "customer": "Vance Residence", "contact": "Nora Vance", "site": "Coldbrook Lane", "work": "Radiant floor install", "status": "complete_unbilled", "foreman": "Tasha Byrd", "start_date": "2026-05-26", "quoted": 2975000, "quoted_hours": 120, "actual_hours": 133, "cost_to_date": 2304000, "invoiced": 1487500, "to_invoice": 1487500 },
          { "id": "J-2377", "customer": "Kirkwood Elementary School District", "contact": "Ruben Ortiz", "site": "Kirkwood Avenue Campus", "work": "Restroom retrofit, phase two", "status": "closed", "foreman": "Rudy Okafor", "start_date": "2026-04-06", "quoted": 8420000, "quoted_hours": 300, "actual_hours": 361, "cost_to_date": 8904600, "invoiced": 8420000, "to_invoice": 0 }
        ]
      }
    },
    "list_job_costs": {
      "does": "Every cost line posted against job J-2418, oldest first. The rows are the `data` array. `kind` is labor, material or subcontractor. `hours` is 0 on anything that is not labor. Labor posts weekly at the crew's burdened rate. `amount` is in CENTS: 319600 is $3,196.00, and the lines add up to the job's cost to date.",
      "takes": { "job_id": "string" },
      "data": {
        "data": [
          { "id": "jc_1101", "job": "J-2418", "date": "2026-07-24", "kind": "material", "description": "Packaged rooftop unit, seven and a half ton", "vendor": "Fairview Plumbing Supply", "hours": 0, "amount": 1284000 },

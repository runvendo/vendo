    "get_receivables_aging": {
      "does": "What customers owe, aged as of `as_of`. `data` is one row per aging bucket and `by_customer` is one row per customer who owes anything, largest balance first, where `days_late` is how late that customer's oldest unpaid invoice is. `total` is everything outstanding and `past_due` is the part of it that is late. Money is in CENTS: 10037500 is $100,375.00.",
      "data": {
        "as_of": "2026-08-12",
        "data": [
          { "bucket": "Current", "amount": 6510000, "invoices": 3 },
          { "bucket": "1-30 days late", "amount": 320000, "invoices": 1 },
          { "bucket": "31-60 days late", "amount": 2592500, "invoices": 2 },
          { "bucket": "61-90 days late", "amount": 0, "invoices": 0 },
          { "bucket": "Over 90 days late", "amount": 615000, "invoices": 1 }
        ],
        "by_customer": [
          { "customer": "Larkspur Apartments LLC", "balance": 4200000, "days_late": 0 },
          { "customer": "Harbor Point Dental", "balance": 1990000, "days_late": 0 },
          { "customer": "Kirkwood Elementary School District", "balance": 1720000, "days_late": 102 },
          { "customer": "Vance Residence", "balance": 1487500, "days_late": 31 },
          { "customer": "Sutter Street Lofts HOA", "balance": 640000, "days_late": 23 }
        ],
        "total": 10037500,
        "past_due": 3527500
      }
    },
    "list_expenses": {

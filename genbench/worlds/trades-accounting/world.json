          { "id": "jc_1107", "job": "J-2418", "date": "2026-08-08", "kind": "labor", "description": "Crew hours, week ending Aug 8 — unit set and ductwork", "vendor": "Ridgeline crew", "hours": 86.5, "amount": 588200 },

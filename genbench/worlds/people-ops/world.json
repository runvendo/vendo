          { "id": "ob_8", "employee_id": "emp_arriaga", "employee_name": "Luz Arriaga", "task": "Sign offer letter and tax forms", "owner": "Sena Nakamura", "category": "paperwork", "due_date": "2026-08-20", "done": false },
          { "id": "ob_9", "employee_id": "emp_arriaga", "employee_name": "Luz Arriaga", "task": "Ship laptop and headset", "owner": "Sena Nakamura", "category": "equipment", "due_date": "2026-08-21", "done": false },

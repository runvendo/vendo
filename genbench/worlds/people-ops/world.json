    "get_headcount_by_department": {
      "does": "Headcount and payroll per department, most expensive first. Counts every row of `list_employees`, including people onboarding and on leave. `annual_payroll_cents` is in CENTS and is the sum of that department's salaries: 74550000 is $745,500.00. `open_roles` is the count of roles that department is hiring for.",
      "data": {
        "data": [
          { "department": "Engineering", "headcount": 4, "annual_payroll_cents": 74550000, "open_roles": 2 },
          { "department": "Support", "headcount": 4, "annual_payroll_cents": 36800000, "open_roles": 1 },
          { "department": "Operations", "headcount": 2, "annual_payroll_cents": 33500000, "open_roles": 0 },
          { "department": "Design", "headcount": 2, "annual_payroll_cents": 26400000, "open_roles": 0 }
        ]
      }
    },
    "get_leave_policy": {
      "does": "The company's time-off policy, as the single row of the `data` array. Balances accrue at `accrual_hours_per_month`; anything above `carryover_cap_hours` is forfeited at year end. `min_notice_days` applies to vacation and unpaid leave only — sick and parental leave are exempt. `blackout_weeks_start` holds the Monday of each week nobody may book off.",
      "data": {
        "data": [
          {
            "accrual_hours_per_month": 12,
            "carryover_cap_hours": 80,
            "hours_per_work_day": 8,
            "min_notice_days": 7,
            "sick_days_per_year": 10,
            "requires_manager_approval": true,
            "blackout_weeks_start": ["2026-11-23", "2026-12-21"]
          }
        ]
      }
    },
    "approve_time_off": {
      "does": "Approve one pending time-off request. The hours come off the employee's balance and the employee is emailed.",
      "takes": { "id": "string" }
    },
    "deny_time_off": {
      "does": "Deny one pending time-off request. The reason is emailed to the employee, so it is required.",
      "takes": { "id": "string", "reason": "string" }
    },
    "complete_onboarding_task": {
      "does": "Mark one onboarding checklist item done.",
      "takes": { "id": "string" }
    },
    "send_review_reminder": {
      "does": "Email one person a reminder that their review step is late. One call per person.",
      "takes": { "employee_id": "string" }
    }
  }
}

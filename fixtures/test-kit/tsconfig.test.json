/* The typecheck config. `tsconfig.json` EMITS `dist/` from `src/` alone, so it
   cannot also carry `tests/` — a rootDir of `src` refuses anything above it. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "tests", "vitest.config.ts"]
}

[2.209, "o", "\u001b[2m│\u001b[22m  \u001b[95m●\u001b[39m your Claude Code login \u001b[2m(--engine claude)\u001b[22m\r\r\n\u001b[2m│\u001b[22m  \u001b[2m○\u001b[22m \u001b[2myour ChatGPT login\u001b[22m \u001b[2m(--engine codex)\u001b[22m\r\r\n\u001b[2m│\u001b[22m  \u001b[2m○\u001b[22m \u001b[2mSkip — keep extractor defaults\u001b[22m\r\r\n"]
